# Copy to .env and fill in. Never commit .env.

# Anthropic API key used by the app's Python back end at runtime: writing answers, checking
# citations, routing questions, and the eval judge. Never sent to the browser.
ANTHROPIC_API_KEY=

# Postgres (ParadeDB) from infra/docker-compose.yml
DATABASE_URL=postgresql://echr:echr@localhost:5433/echr

# snapshot = small committed demo corpus in data/snapshot (default, works offline)
# full     = full UK corpus downloaded into data/full
DATA_SOURCE=snapshot

# Where the web app finds the FastAPI service
API_URL=http://localhost:8000

# --- Optional overrides (defaults shown) ---
# ANSWER_MODEL=claude-sonnet-5-5
# ROUTER_MODEL=claude-haiku-5-5
# VERIFY_MODEL=claude-haiku-5-5
# JUDGE_MODEL=claude-sonnet-5-5
# EMBEDDER=BAAI/bge-small-en-v1.5
# RERANKER=BAAI/bge-reranker-base
# RERANK_ENABLED=1
# LLM_MODE=live
