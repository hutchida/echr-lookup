{
  "name": "@echr/contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zod schemas: the single source of truth for every API shape. Exports JSON Schema to schema/*.json.",
  "exports": {
    ".": "./src/index.ts",
    "./schema/*": "./schema/*",
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "export": "tsx scripts/export-json-schema.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
