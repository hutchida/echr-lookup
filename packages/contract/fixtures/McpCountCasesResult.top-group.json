  "filters": "admissibility decisions about deportation, expulsion, removal or extradition dated between 1990-01-01 and 2025-12-31 that were declared inadmissible",
  "definitions": [
    "'Declared inadmissible' means the whole application was declared inadmissible; partly inadmissible decisions are not counted.",
    "HUDOC has no topic field, so a 'deportation' case is one that raises Article 3, 8 or 5(1)(f) and has at least 2 paragraphs containing a word starting deport, expel, expulsion, extradit or removal.",
    "Grounds come from HUDOC's conclusion where it names one, otherwise from the decision text; a decision can rest on several grounds, so the rows can add up to more than the total."
  ],
  "sql": "WITH matched AS (\n  SELECT d.item_id, d.case_name, d.date, d.doc_type, d.outcome, d.articles, d.inadmissibility_grounds\n  FROM documents d\n  WHERE d.doc_type IN ('decision')\n    AND d.outcome IN ('inadmissible')\n    AND d.date >= '1990-01-01'\n    AND d.date <= '2025-12-31'\n    AND EXISTS (SELECT 1 FROM unnest(d.articles) AS a WHERE split_part(a, '-', 1) IN ('3', '8', '5-1-f') OR a IN ('3', '8', '5-1-f'))\n    AND (SELECT count(*) FROM paragraphs p WHERE p.doc_id = d.item_id AND p.text ~* '[[:<:]](deport|expel|expulsion|extradit|removal)') >= 2\n)\nSELECT COALESCE(g, '(not stated)') AS reason, count(*) AS documents\nFROM matched LEFT JOIN LATERAL unnest(inadmissibility_grounds) AS g ON true\nGROUP BY 1 ORDER BY 2 DESC, 1 LIMIT 20;\n-- also run on the same `matched` set: SELECT count(*) FROM matched; and the 8 most recent items, each with an example paragraph",
  "columns": [
    "reason",
    "documents"
  ],
