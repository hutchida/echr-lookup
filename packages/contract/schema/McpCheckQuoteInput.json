{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/McpCheckQuoteInput",
  "$defs": {
    "McpCheckQuoteInput": {
      "type": "object",
      "properties": {
        "paragraph_id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*§[A-Za-z0-9._-]+$"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "the text you intend to quote from that paragraph"
        }
      },
      "required": [
        "paragraph_id",
        "quote"
      ],
      "additionalProperties": false,
      "description": "check_quote arguments"
    }
  }
}
