{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Chunk",
  "$defs": {
    "Chunk": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "<doc-id>:<strategy>:<index>, e.g. 001-57619:recursive:41"
        },
        "doc_id": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "strategy": {
          "type": "string",
          "enum": [
            "fixed",
            "recursive",
            "by_section"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "paragraph_ids": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*§[A-Za-z0-9._-]+$"
          },
          "description": "paragraphs this chunk covers, in order"
        },
        "token_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "tokens by the embedder's tokenizer"
        }
      },
      "required": [
        "id",
        "doc_id",
        "strategy",
        "text",
        "paragraph_ids",
        "token_count"
      ],
      "additionalProperties": false,
      "description": "A retrievable passage"
    }
  }
}
