{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/SearchRequest",
  "$defs": {
    "SearchRequest": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "mode": {
          "type": "string",
          "enum": [
            "bm25",
            "vector",
            "hybrid",
            "hybrid_rerank"
          ]
        },
        "chunking": {
          "type": "string",
          "enum": [
            "fixed",
            "recursive",
            "by_section"
          ]
        },
        "k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "filters": {
          "type": "object",
          "properties": {
            "article": {
              "description": "HUDOC article code, e.g. '3' or 'P1-3'",
              "type": "string"
            },
            "doc_types": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "judgment",
                  "decision",
                  "communicated",
                  "legal_summary",
                  "legislation"
                ]
              }
            },
            "outcomes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "violation",
                  "no_violation",
                  "mixed",
                  "inadmissible",
                  "partly_inadmissible",
                  "struck_out",
                  "admissible",
                  "other",
                  "not_applicable"
                ]
              }
            },
            "date_from": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            "date_to": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "query",
        "mode",
        "chunking",
        "k"
      ],
      "additionalProperties": false,
      "description": "POST /search body"
    }
  }
}
