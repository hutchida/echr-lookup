{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/EvalRun",
  "$defs": {
    "EvalRun": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "data_source": {
          "type": "string",
          "enum": [
            "snapshot",
            "full"
          ]
        },
        "config": {
          "type": "object",
          "properties": {
            "chunking": {
              "type": "string",
              "enum": [
                "fixed",
                "recursive",
                "by_section"
              ]
            },
            "mode": {
              "type": "string",
              "enum": [
                "bm25",
                "vector",
                "hybrid",
                "hybrid_rerank"
              ]
            },
            "rerank": {
              "type": "boolean"
            },
            "embedder_model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "generator_model": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 60
                },
                {
                  "type": "null"
                }
              ],
              "description": "null for retrieval-only runs"
            },
            "judge_model": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 60
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "chunking",
            "mode",
            "rerank",
            "embedder_model",
            "generator_model",
            "judge_model"
          ],
          "additionalProperties": false
        },
        "metrics": {
          "type": "object",
          "properties": {
            "recall_at_5": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "recall_at_10": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "mrr": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "faithfulness": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "citation_accuracy": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "neutrality": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "recall_at_5",
            "recall_at_10",
            "mrr",
            "faithfulness",
            "citation_accuracy",
            "neutrality"
          ],
          "additionalProperties": false
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "tokens_in": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokens_out": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timings_ms": {
          "type": "object",
          "properties": {
            "total": {
              "type": "number",
              "minimum": 0
            },
            "mean_per_item": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "total",
            "mean_per_item"
          ],
          "additionalProperties": false
        },
        "items": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item_id": {
                "type": "string",
                "minLength": 1
              },
              "retrieved_paragraph_ids": {
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*§[A-Za-z0-9._-]+$"
                },
                "description": "top-10 paragraph ids, best first"
              },
              "recall_at_5": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "recall_at_10": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reciprocal_rank": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "faithfulness": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "citation_accuracy": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "neutrality": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "latency_ms": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "item_id",
              "retrieved_paragraph_ids",
              "recall_at_5",
              "recall_at_10",
              "reciprocal_rank",
              "faithfulness",
              "citation_accuracy",
              "neutrality",
              "latency_ms"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "run_id",
        "started_at",
        "finished_at",
        "data_source",
        "config",
        "metrics",
        "cost_usd",
        "tokens_in",
        "tokens_out",
        "timings_ms",
        "items"
      ],
      "additionalProperties": false,
      "description": "Result of running the eval set under one configuration (GET /eval-runs/{id})"
    }
  }
}
