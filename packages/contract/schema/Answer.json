{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Answer",
  "$defs": {
    "Answer": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "question": {
          "type": "string",
          "maxLength": 500
        },
        "route": {
          "type": "string",
          "enum": [
            "rag",
            "stats"
          ]
        },
        "answer_text": {
          "type": "string",
          "maxLength": 3000
        },
        "claims": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "citation_ids": {
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*§[A-Za-z0-9._-]+$"
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "supported",
                  "unsupported",
                  "unverified"
                ]
              },
              "reason": {
                "type": "string",
                "maxLength": 160,
                "description": "short reason for the verification status"
              },
              "role": {
                "description": "absent means \"point\"; at most one \"short_answer\", and it is the first claim",
                "type": "string",
                "enum": [
                  "short_answer",
                  "point"
                ]
              },
              "group": {
                "description": "short neutral heading shared by consecutive points, e.g. \"Where the Court allowed the deportation\"",
                "type": "string",
                "maxLength": 80
              }
            },
            "required": [
              "id",
              "text",
              "citation_ids",
              "status",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "citations": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "paragraph_id": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*§[A-Za-z0-9._-]+$"
              },
              "doc_id": {
                "type": "string",
                "maxLength": 40,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "case_name": {
                "type": "string",
                "maxLength": 120
              },
              "doc_type": {
                "type": "string",
                "enum": [
                  "judgment",
                  "decision",
                  "communicated",
                  "legal_summary",
                  "legislation"
                ],
                "description": "type of the cited paragraph's document, so a legal summary is never mistaken for the judgment"
              },
              "quote": {
                "type": "string",
                "maxLength": 300,
                "description": "verbatim snippet from that paragraph"
              },
              "link_target": {
                "type": "string",
                "maxLength": 200,
                "description": "URL or app route that opens the paragraph"
              }
            },
            "required": [
              "paragraph_id",
              "doc_id",
              "case_name",
              "doc_type",
              "quote",
              "link_target"
            ],
            "additionalProperties": false
          }
        },
        "stats": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatsQueryResult"
            },
            {
              "type": "null"
            }
          ],
          "description": "set only when route = stats"
        },
        "refused_or_not_in_sources": {
          "type": "boolean",
          "description": "true when the sources do not answer the question"
        },
        "steps": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": {
                "type": "string",
                "enum": [
                  "route",
                  "retrieve",
                  "rerank",
                  "generate",
                  "verify"
                ]
              },
              "model": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "null for non-model steps such as retrieve"
              },
              "tokens_in": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "tokens_out": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "tokens_cached": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "cost_usd": {
                "type": "number",
                "minimum": 0
              },
              "latency_ms": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "step",
              "model",
              "tokens_in",
              "tokens_out",
              "tokens_cached",
              "cost_usd",
              "latency_ms"
            ],
            "additionalProperties": false
          }
        },
        "total_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "total_latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "models_used": {
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 60
          }
        }
      },
      "required": [
        "request_id",
        "question",
        "route",
        "answer_text",
        "claims",
        "citations",
        "stats",
        "refused_or_not_in_sources",
        "steps",
        "total_cost_usd",
        "total_latency_ms",
        "models_used"
      ],
      "additionalProperties": false,
      "description": "POST /ask response (payload < 50 KB)"
    },
    "StatsQueryResult": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "maxLength": 500
        },
        "sql": {
          "type": "string",
          "maxLength": 1500,
          "description": "the read-only SQL that produced the rows"
        },
        "columns": {
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "matching_cases": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "doc_id": {
                "type": "string",
                "maxLength": 40,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "case_name": {
                "type": "string",
                "maxLength": 120
              },
              "doc_type": {
                "type": "string",
                "enum": [
                  "judgment",
                  "decision",
                  "communicated",
                  "legal_summary",
                  "legislation"
                ]
              },
              "paragraph_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*§[A-Za-z0-9._-]+$"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "the quoted paragraph; null when no paragraph honestly illustrates the filter (e.g. no operative clause states the violation)"
              },
              "quote": {
                "type": "string",
                "maxLength": 300,
                "description": "verbatim snippet from that paragraph; empty when paragraph_id is null"
              },
              "link_target": {
                "type": "string",
                "maxLength": 200,
                "description": "/case/<doc_id>#p<ref>, or /case/<doc_id> when no paragraph is quoted"
              }
            },
            "required": [
              "doc_id",
              "case_name",
              "doc_type",
              "paragraph_id",
              "quote",
              "link_target"
            ],
            "additionalProperties": false
          }
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "number of matching documents (can exceed rows shown)"
        },
        "scope_total": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "when the question asks for a total AND how many of those have an outcome: the documents in the scope before the outcome filter (count is the subset); otherwise null"
        },
        "explanation": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "question",
        "sql",
        "columns",
        "rows",
        "matching_cases",
        "count",
        "scope_total",
        "explanation"
      ],
      "additionalProperties": false,
      "description": "Counting-question result, from SQL over metadata. Returned inside Answer.stats by POST /ask (route = stats)"
    }
  }
}
